{
  "schema_version": 2,
  "title": "Awesome Robot World Models",
  "companion_to": "From Prediction to Control: A Survey of Closed-Loop World Models for Robot Learning",
  "repository": "https://github.com/awesome-robot-world-model/awesome-robot-world-model",
  "paper_links": {
    "arxiv": null,
    "pdf": null
  },
  "citation": null,
  "summary": [
    "A world model affects a robot only through the component that consumes its predictions, so the quality of a world model is relative to its consumer.",
    "The survey describes each model by four design dials, follows its predictions through five pathways to the learners and policies that change robot behavior, and relates these pathways to embodiment requirements, real-world evaluation and the outer loop that refits models from deployment data."
  ],
  "dials": [
    {
      "id": "Y",
      "subsection": "subsec:dial-y",
      "question": "What is predicted?",
      "ends": [
        "pixels",
        "task quantities"
      ],
      "tradeoff": [
        "general",
        "decision-sufficient"
      ]
    },
    {
      "id": "C",
      "subsection": "subsec:dial-c",
      "question": "Conditioned on what?",
      "ends": [
        "passive video",
        "robot actions"
      ],
      "tradeoff": [
        "passive",
        "controllable"
      ]
    },
    {
      "id": "D",
      "subsection": "subsec:dial-d",
      "question": "Learned from what?",
      "ends": [
        "web video",
        "robot data"
      ],
      "tradeoff": [
        "abundant",
        "grounded"
      ]
    },
    {
      "id": "M",
      "subsection": "subsec:dial-m",
      "question": "Computed how?",
      "ends": [
        "rich generators",
        "compact"
      ],
      "tradeoff": [
        "expressive",
        "fast"
      ]
    }
  ],
